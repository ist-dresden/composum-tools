<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.composum.tools</groupId>
        <artifactId>composum-tools-aem-parent</artifactId>
        <version>1.3.2-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>

    <artifactId>composum-tools-aem-config</artifactId>
    <packaging>content-package</packaging>

    <name>Composum Tools - AEM - Configuration Example</name>
    <description>the AEM configuration package example</description>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <group>${project.groupId}</group>
                    <name>${project.artifactId}</name>
                    <packageType>container</packageType>
                    <properties>
                        <cloudManagerTarget>none</cloudManagerTarget>
                    </properties>
                    <filters>
                        <!-- 'update' rather than the default 'replace': adds/updates only the
                             nodes this package actually ships, and never removes anything else
                             found under these (potentially shared) folders -->
                        <filter>
                            <root>/apps/composum/osgiconfig/config</root>
                            <mode>update</mode>
                        </filter>
                        <filter>
                            <root>/apps/composum/osgiconfig/config.author</root>
                            <mode>update</mode>
                        </filter>
                    </filters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.wcm.maven.plugins</groupId>
                <artifactId>wcmio-content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>

        </plugins>
    </build>
    <profiles>

        <profile>
            <id>installPackageAEM</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.wcm.maven.plugins</groupId>
                        <artifactId>wcmio-content-package-maven-plugin</artifactId>
                        <configuration>
                            <serviceURL>http://localhost:4502/crx/packmgr/service</serviceURL>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-package</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>installPackageAEMPublish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.wcm.maven.plugins</groupId>
                        <artifactId>wcmio-content-package-maven-plugin</artifactId>
                        <configuration>
                            <serviceURL>http://localhost:4503/crx/packmgr/service</serviceURL>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-package</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>install</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
